{
  "expo": {
    "name": "Media Downloader",
    "slug": "media-downloader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "用于将下载的图片和视频保存到系统相册",
        "NSPhotoLibraryUsageDescription": "用于将下载的图片和视频保存到系统相册"
      },
      "bundleIdentifier": "com.anonymous.mediadownloader"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0C10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.anonymous.mediadownloader"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-video",
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "允许访问相册以便保存下载的图片",
          "savePhotosPermission": "允许保存下载的图片到相册",
          "videosPermission": "允许访问视频以便保存下载的视频",
          "saveVideosPermission": "允许保存下载的视频到相册",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4da56464-4d1f-4fe9-b593-3dccd8d02947"
      }
    },
    "owner": "ubiyachi"
  }
}
